# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# From Kalshi account: https://kalshi.com/account/profile -> API Keys -> Create New API Key
KALSHI_API_KEY_ID=your-key-id-here

# Absolute path to the private key file Kalshi downloads when you create the key.
# Keep this file OUTSIDE the repo (e.g. ~/secrets/kalshi_private_key.txt).
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.txt

# Production base URL. Kalshi also serves the same API at https://external-api.kalshi.com/trade-api/v2
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# Max API requests per second the pipeline will send (Basic tier is ~20 read req/s; keep this conservative).
KALSHI_MAX_REQUESTS_PER_SECOND=8

# Where the SQLite database is written.
KALSHI_DB_PATH=data/kalshi.db
